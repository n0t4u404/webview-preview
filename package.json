{
	"name": "webview-preview",
	"version": "1.2.0",
	"description": "Check a Tauri or Wails UI in the engine it really runs on — WebKitGTK, Edge (WebView2), WebKit — from the command line: steps, snapshots, baselines, and an annotate window to point at elements and say what to change.",
	"license": "MIT",
	"author": "n0t4u404",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n0t4u404/webview-preview.git"
	},
	"keywords": [
		"tauri",
		"wails",
		"webview",
		"webkitgtk",
		"webview2",
		"webkit",
		"playwright",
		"screenshot",
		"visual-testing",
		"visual-regression",
		"ui-testing",
		"annotation",
		"design-review",
		"developer-tools",
		"cli",
		"ai-agents",
		"react",
		"vue"
	],
	"type": "module",
	"main": "./src/index.mjs",
	"types": "./src/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"default": "./src/index.mjs"
		}
	},
	"imports": {
		"#src/*": "./src/*"
	},
	"scripts": {
		"test": "node --test"
	},
	"bin": {
		"webview-preview": "bin/webview-preview.mjs"
	},
	"files": [
		"bin",
		"src",
		"AGENTS.md"
	],
	"engines": {
		"node": ">=18"
	},
	"peerDependencies": {
		"playwright-core": "^1.40.0"
	},
	"peerDependenciesMeta": {
		"playwright-core": {
			"optional": true
		}
	},
	"devDependencies": {
		"playwright-core": "^1.64.1"
	},
	"homepage": "https://github.com/n0t4u404/webview-preview#readme"
}